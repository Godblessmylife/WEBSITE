# Шаблон .env - копия БЕЗ настоящих секретов, безопасно коммитить.
# Реальный .env создаётся вручную рядом (в .gitignore, никогда не
# коммитится) - см. .env для актуальных значений.

# CryptoCloud / Trybit - платёжный шлюз. API-ключ и Shop ID - из личного
# кабинета CryptoCloud/Trybit. Без префикса VITE_ намеренно - секрет не
# должен попасть в клиентский JS-бандл (см. подробности в .env).
CRYPTOCLOUD_API_KEY=
CRYPTOCLOUD_SHOP_ID=

CRYPTOCLOUD_PAYMENT_LINK=
CRYPTOCLOUD_SUCCESS_URL=
CRYPTOCLOUD_FAIL_URL=
CRYPTOCLOUD_CALLBACK_URL=
